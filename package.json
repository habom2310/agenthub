{
  "name": "@habom2310/agenthub",
  "version": "0.1.0",
  "description": "Unified configuration, skills, rules, and MCP management engine for AI coding assistants",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agenthub": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "habom2310",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habom2310/agenthub.git"
  },
  "homepage": "https://github.com/habom2310/agenthub#readme",
  "bugs": {
    "url": "https://github.com/habom2310/agenthub/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "rules",
    "skills",
    "mcp",
    "antigravity",
    "claude-code",
    "codex",
    "cursor",
    "windsurf"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
